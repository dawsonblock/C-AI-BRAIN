# Environment configuration for docker-compose
# Copy to .env and customize

# Security
API_KEY=your-production-api-key-change-this

# CORS - comma-separated origins (leave empty for production)
CORS_ORIGINS=

# Embeddings
EMBEDDING_BACKEND=cpu
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# Logging
LOG_LEVEL=INFO

# Optional monitoring
# GRAFANA_PASSWORD=secure-password-here
